APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Core PayPal Sandbox credentials (Orders v2 API)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional PayPal Webhook ID (from PayPal Developer Dashboard)
PAYPAL_WEBHOOK_ID=

# SQLite database path for persistent orders, inventory, and webhooks
AGENTPAY_DB_PATH=agentpay.db

# Operator admin token for protected operations (refunds, inventory adjustments, MCP)
AGENTPAY_ADMIN_TOKEN=db9564baea7c375df8781732c0961a59d91991480814c69b8a418db39d9910b8

# Optional PayPal MCP Bridge (@paypal/agent-toolkit-mcp)
PAYPAL_MCP_ENABLED=true

# Optional PayPal Subscriptions configuration
PAYPAL_SUBSCRIPTIONS_CLIENT_ID=
PAYPAL_SUBSCRIPTIONS_SECRET=
PAYPAL_SUBSCRIPTIONS_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SUBSCRIPTIONS_PLAN_ID=

# Optional post-purchase Zapier Catch Hook webhook URL
ZAPIER_WEBHOOK_URL=

# Channel3 product discovery, visual shopping, and conversational agent
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
CHANNEL3_SEARCH_MODE=agentic

# Optional Elastic Cloud / Elasticsearch telemetry and trace search
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=agentpay
